---
import { FaRss, FaRegCopyright } from "react-icons/fa";
import { SITE_AUTHOR } from "../consts";
---

<div class="m-2 flex flex-col items-center">
  <div class="flex items-center">
    <FaRegCopyright />&ensp;2025 {SITE_AUTHOR}.&ensp;All Rights
    Reserved.&ensp;/&ensp;<FaRss />&ensp;<a
      class="text-[var(--primary-color)]"
      href="/rss.xml">RSS</a
    >
  </div>
  <div>
    Powered by<a
      href="https://astro.build/"
      class="text-[var(--primary-color)]"
    >
      Astro</a
    > & <a href="https://react.dev/" class="text-[var(--primary-color)]"
      >React</a
    >
  </div>
</div>
