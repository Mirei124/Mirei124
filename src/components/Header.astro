---
import avator from "../assets/avator.webp";
import { FaSun } from "react-icons/fa";
import { Image } from "astro:assets";
import { SITE_AUTHOR } from "../consts";
---

<div
  class="mt-2 flex w-[50rem] items-center justify-between rounded-xl bg-[#ffffffdd] p-2 backdrop-blur"
>
  <div class="hidden md:flex items-center">
    <a href="/"
      ><Image src={avator} alt="avator" class="ml-2 h-8 w-8 rounded-full" /></a
    >
    <a
      class="mx-2 rounded p-2 text-xl font-semibold text-gray-800 hover:bg-[var(--lighten-color)]"
      href="/">{SITE_AUTHOR}</a
    >
  </div>
  <nav class="text-xl font-semibold text-gray-800">
    <a class="mx-2 rounded p-2 hover:bg-[var(--lighten-color)]" href="/">博客</a
    >
    <!-- TODO: -->
    <a class="mx-2 rounded p-2 hover:bg-[var(--lighten-color)]" href="/tags"
      >标签</a
    >
    <a class="mx-2 rounded p-2 hover:bg-[var(--lighten-color)]" href="/archive"
      >归档</a
    >
    <a class="mx-2 rounded p-2 hover:bg-[var(--lighten-color)]" href="/about"
      >关于</a
    >
  </nav>
  <div class="hidden md:flex min-w-36 justify-end text-gray-800">
    <FaSun
      className="icon h-10 w-10 rounded p-2 text-2xl hover:bg-[var(--lighten-color)]"
    />
    <!-- <FaSearch /> -->
  </div>
</div>
